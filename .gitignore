local.env
# Pesos, corridas y fotos del aforo + caches Python: nunca entran al repo
# (pesan decenas de MB y las fotos muestran pasajeros: Ley 1581).
prototipo-aforo/**/*.pt
prototipo-aforo/runs/
prototipo-aforo/dataset/
**/__pycache__/

# Grafo local de graphify: caché de búsqueda que se regenera, no es del repo.
graphify-out/

# Cuenta de servicio de Firebase para los avisos por push (D13): es una clave
# privada. Va fuera del repo y llega por YA_VIENE_FCM_CREDENCIALES.
fcm-credenciales*.json
*-firebase-adminsdk-*.json
