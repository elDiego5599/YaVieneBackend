<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla: instalar-servicios.sh reemplaza @@SCRIPTS@@, @@REPO@@, @@LOGS@@
  y @@PATH@@ por las rutas de este Mac. Copia la base cada hora y poda las
  viejas; el archivo instalado no se edita a mano.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yaviene.respaldo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@@SCRIPTS@@/respaldar.sh</string>
  </array>

  <!-- La base vive en data/ dentro del repo: sin esto el script buscaría
       data/yaviene.db en la carpeta desde la que launchd arranca. -->
  <key>WorkingDirectory</key>
  <string>@@REPO@@</string>

  <!-- Cada hora, en punto. No StartInterval: ese contador solo corre con el
       Mac despierto y al despertar no se pone al día (el 2026-11-04 la
       última copia seguía siendo la de las 03:02 a las 10:30). Con
       StartCalendarInterval, si el Mac dormía a la hora en punto, launchd
       corre la copia en cuanto despierta, una sola vez y no una por cada
       hora perdida. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Al cargar no: cargar el servicio no es motivo para copiar, y la
       primera copia llega a la siguiente hora en punto. Para una copia ya mismo está
       `npm run respaldo`. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Background: copiar la base es trabajo de fondo y no tiene por qué
       pelear disco con el backend, que sí publica posiciones cada 400 ms. -->
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>@@LOGS@@/respaldo.log</string>
  <key>StandardErrorPath</key>
  <string>@@LOGS@@/respaldo.log</string>

  <!-- launchd no hereda el PATH del terminal: sin esto `node` no aparece. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@PATH@@</string>
  </dict>
</dict>
</plist>
