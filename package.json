{
  "name": "ya-viene-backend",
  "version": "0.1.0",
  "description": "Backend en tiempo real para Ya Viene — MQTT + WebSocket bridge para seguimiento de buses en Barranquilla",
  "main": "src/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --import ./tests/entorno.ts --test tests/*.test.ts",
    "test:aforo": "python -m unittest discover -s prototipo-aforo/tests",
    "backup": "node scripts/backup-db.mjs",
    "respaldo": "node scripts/respaldar.mjs",
    "respaldo:probar": "node scripts/probar-restauracion.mjs",
    "carga": "node --import tsx scripts/carga.ts",
    "test:cobertura": "node --import tsx --import ./tests/entorno.ts --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"dist/**\" --test-coverage-lines=92 --test-coverage-branches=79 --test-coverage-functions=92 tests/*.test.ts",
    "contrato:actualizar": "ACTUALIZAR_CONTRATO=1 node --import tsx --import ./tests/entorno.ts --test tests/contrato.test.ts"
  },
  "keywords": [
    "barranquilla",
    "bus-tracking",
    "mqtt",
    "websocket"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aedes": "0.51.3",
    "better-sqlite3": "^13.0.2",
    "jsonwebtoken": "^9.0.3",
    "mqemitter": "6.0.2",
    "mqtt": "^5.15.2",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
